# ========== OnlyOffice 配置 ==========

# OnlyOffice Document Server 地址（默认 http://localhost:8080）
# 如果 OnlyOffice 部署在其他服务器，修改为对应地址
ONLYOFFICE_URL=http://localhost:8080

# 当前系统对外可访问的地址（OnlyOffice 回调用）
# 生产环境必须改为实际域名或IP
CALLBACK_BASE_URL=http://localhost:4000

# JWT Secret（与 OnlyOffice 的 JWT_SECRET 保持一致）
JWT_SECRET=reportapp-secret-key-2024
